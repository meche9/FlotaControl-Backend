# ─── Base de datos ───────────────────────────────────────────────
DATABASE_URL="mysql://usuario:password@localhost:3306/flotacontrol"

# ─── Servidor ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Orígenes del frontend permitidos (CORS y verificación CSRF), separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# URL pública del frontend (para el enlace de restablecimiento de contraseña)
FRONTEND_URL=http://localhost:5173
# Si la API está detrás de un proxy/balanceador: número de saltos o "true"
# TRUST_PROXY=1
# Carpeta donde se guardan las fotos de vehículos y usuarios (JPG, PNG o WEBP, máx. 5 MB)
UPLOADS_DIR=uploads

# ─── JWT / sesión ────────────────────────────────────────────────
# Mínimo 32 caracteres aleatorios. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
# Duración de la sesión sin "Recordar estación" (horas) y con ella (días)
REFRESH_SESSION_TTL_HOURS=12
REFRESH_REMEMBER_TTL_DAYS=7
# Cookie del refresh token: en producción con HTTPS COOKIE_SECURE=true.
# Si frontend y API están en dominios distintos: COOKIE_SAMESITE=none (requiere COOKIE_SECURE=true)
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
BCRYPT_ROUNDS=12

# ─── Restablecimiento de contraseña / correo ─────────────────────
RESET_TOKEN_TTL_MINUTES=30
# Sin SMTP_HOST (solo en desarrollo) el enlace se muestra en la consola del servidor
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FleetFlow <no-reply@fleetflow.com>"

# ─── Seed (pnpm db:seed) ─────────────────────────────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NOMBRE=Administrador
SEED_ADMIN_APELLIDO=FleetFlow
