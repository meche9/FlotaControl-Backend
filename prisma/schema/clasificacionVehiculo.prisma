model ClasificacionVehiculo {
  idClasificacion   String            @id @default(uuid()) @map("id_clasificacion") @db.VarChar(36)
  idTipo            String            @map("id_tipo") @db.VarChar(36)
  nombreClasificacion String          @map("nombre_clasificacion") @db.VarChar(50)
  activo            Boolean           @default(true)
  
  tipo              TipoVehiculo      @relation(fields: [idTipo], references: [idTipo], onDelete: Restrict)
  vehiculos         Vehicle[]
  matrizTarifas     MatrizTarifa[]

  @@map("clasificaciones_vehiculos")
}