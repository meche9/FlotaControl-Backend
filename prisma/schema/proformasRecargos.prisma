
enum RecargoAprobacion {
  Aprobado
  Aprobado_Parcial  @map("Aprobado Parcial")
  Rechazado
}

model ProformaRecargo {
  idProformaRecargo   String              @id @default(uuid()) @map("id_proforma_recargo") @db.VarChar(36)
  idDetalle           String              @map("id_detalle") @db.VarChar(36)
  idRecargo           String?             @map("id_recargo") @db.VarChar(36)
  montoTotalAprobado  Decimal             @map("monto_total_aprobado") @db.Decimal(10, 2)
  estadoAprobacion    RecargoAprobacion   @default(Aprobado) @map("estado_aprobacion")

  detalle             ProformaDetalle     @relation(fields: [idDetalle], references: [idDetalle], onDelete: Cascade)
  recargo             RutaRecargo?        @relation(fields: [idRecargo], references: [idRecargo], onDelete: SetNull)
  guiasRecargos       GuiaViajeRecargo[]

  @@map("proforma_recargos")
}
