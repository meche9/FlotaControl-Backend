model TipoVehiculo {
  idTipo         String                     @id @default(uuid()) @map("id_tipo") @db.VarChar(36)
  nombreTipo     String                     @unique @map("nombre_tipo") @db.VarChar(50)
  activo         Boolean                    @default(true)
  clasificaciones ClasificacionVehiculo[]

  @@map("tipos_vehiculos")
}