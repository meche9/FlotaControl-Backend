model Cliente {
  idCliente           Int                 @id @default(autoincrement()) @map("id_cliente")
  razonSocial         String              @map("razon_social") @db.VarChar(150)
  nombreComercial     String?             @map("nombre_comercial") @db.VarChar(150)
  rif                 String              @unique @db.VarChar(30)
  direccionFiscal     String              @map("direccion_fiscal") @db.VarChar(255)
  telefonoContacto    String              @map("telefono_contacto") @db.VarChar(30)
  personaContacto     String              @map("persona_contacto") @db.VarChar(255)
  emailFacturacion    String              @map("email_facturacion") @db.VarChar(100)
  fechaCreacion       DateTime            @default(now()) @map("fecha_creacion")
  fechaActualizacion  DateTime            @default(now()) @updatedAt @map("fecha_actualizacion")

  puntosCargaDescarga PuntoCargaDescarga[]
  guiasViajes         GuiaViaje[]
  matrizTarifas       MatrizTarifa[]
  proformas           Proforma[]

  @@map("clientes")
}