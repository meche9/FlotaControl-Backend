enum UsuarioEstado {
  activo
  inactivo
  suspendido
}

model Usuario {
  id            String        @id @default(uuid()) @db.VarChar(36)
  rolId         String        @map("rol_id") @db.VarChar(36)
  nombre        String        @db.VarChar(100)
  apellido      String        @db.VarChar(100)
  email         String        @unique @db.VarChar(150)
  passwordHash  String        @map("password_hash") @db.VarChar(255)
  telefono      String?       @db.VarChar(20)
  estado        UsuarioEstado @default(activo)
  ultimoAcceso  DateTime?     @map("ultimo_acceso")
  // Se incrementa al cambiar/restablecer la contraseña: invalida todos los access tokens emitidos
  tokenVersion  Int           @default(0) @map("token_version")
  creadoEn      DateTime      @default(now()) @map("creado_en")
  actualizadoEn DateTime      @default(now()) @updatedAt @map("actualizado_en")

  rol           Role                 @relation(fields: [rolId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  resetTokens   PasswordResetToken[]
  refreshTokens RefreshToken[]

  @@map("usuarios")
}
