
enum GuiaRecargoEstado {
  Pendiente
  Procesado
  Rechazado
}
model GuiaViajeRecargo {
  idViajeRecargo        String              @id @default(uuid()) @map("id_viaje_recargo") @db.VarChar(36)
  idOrden               String              @map("id_orden") @db.VarChar(36)
  idRecargo             String?             @map("id_recargo") @db.VarChar(36)
  monto                 Decimal             @db.Decimal(12, 2)
  estado                GuiaRecargoEstado   @default(Pendiente)
  idProformaRecargo     String?             @map("id_proforma_recargo") @db.VarChar(36)
  observaciones         String?             @db.Text

  fechaCreacion         DateTime            @default(now()) @map("fecha_creacion")
  fechaActualizacion    DateTime            @default(now()) @updatedAt @map("fecha_actualizacion")

  orden                 GuiaViaje           @relation(fields: [idOrden], references: [idOrden], onDelete: Cascade, onUpdate: Cascade)
  recargo               RutaRecargo?        @relation(fields: [idRecargo], references: [idRecargo], onDelete: SetNull, onUpdate: Restrict)
  proformaRecargo       ProformaRecargo?    @relation(fields: [idProformaRecargo], references: [idProformaRecargo], onDelete: SetNull, onUpdate: Restrict)

  @@map("guias_viajes_recargos")
}