

model DocumentoVehiculo {
  idDocumentoVehiculo String            @id @default(uuid()) @map("id_documento_vehiculo") @db.VarChar(36)
  idVehiculo String @map("id_vehiculo") @db.VarChar(36)
  idTipoDocumento     String            @map("id_tipo_documento") @db.VarChar(36)
  numeroDocumento     String?           @map("numero_documento") @db.VarChar(100)
  fechaEmision        DateTime?         @map("fecha_emision") @db.Date
  fechaVencimiento    DateTime          @map("fecha_vencimiento") @db.Date
  archivoUrl          String?           @map("archivo_url") @db.VarChar(255)
  estado              DocumentoEstado   @default(Vigente)
  observaciones       String?           @db.Text
  fechaCreacion       DateTime          @default(now()) @map("fecha_creacion")
  fechaActualizacion  DateTime          @default(now()) @updatedAt @map("fecha_actualizacion")

  vehiculo            Vehicle           @relation(fields: [idVehiculo], references: [idVehiculo], onDelete: Cascade)
  tipoDocumento       TipoDocumento     @relation(fields: [idTipoDocumento], references: [idTipoDocumento], onDelete: Restrict)

  @@map("documentos_vehiculos")
}