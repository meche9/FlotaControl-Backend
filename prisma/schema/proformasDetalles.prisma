model ProformaDetalle {
  idDetalle               String            @id @default(uuid()) @map("id_detalle") @db.VarChar(36)
  idProforma              String            @map("id_proforma") @db.VarChar(36)
  idOrden                 String            @unique @map("id_orden") @db.VarChar(36)
  nroTransporte           Int               @map("nro_transporte")
  montoFleteAprobado      Decimal           @map("monto_flete_aprobado") @db.Decimal(12, 2)
  diferenciaFlete         Decimal?          @default(0.00) @map("diferencia_flete") @db.Decimal(12, 2)
  totalRecargosAprobados  Decimal           @default(0.00) @map("total_recargos_aprobados") @db.Decimal(12, 2)
  observacionViaje        String?           @map("observacion_viaje") @db.VarChar(255)

  proforma                Proforma          @relation(fields: [idProforma], references: [idProforma], onDelete: Cascade)
  orden                   GuiaViaje         @relation(fields: [idOrden], references: [idOrden])
  recargos                ProformaRecargo[]

  @@map("proforma_detalles")
}